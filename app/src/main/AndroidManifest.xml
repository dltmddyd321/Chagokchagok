<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Pleos 차량 퍼미션: 실제로 사용하는 도메인만 선언 (승인되지 않은 퍼미션은 마켓 심사 탈락)
        조회 pleos.car.permission.CAR_*, 제어 pleos.car.permission.CONTROL_CAR_*
        CAR_DOORS, CAR_WINDOWS, CAR_CLIMATE, CAR_DRIVE, CAR_ENERGY, CAR_INFO,
        CAR_LIGHTS, CAR_MIRRORS, CAR_SAFETY, CAR_SEATS, CAR_TOLL
    -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- 좌석 착석 센서: 짐과 탑승 인원 화면의 동승자 수 기본값 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- SDK별 필수 퍼미션 (선언 안 하면 호출 시 SecurityException) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 도착·주차 리마인드: 길안내 중 백그라운드 감지 + 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hyundae">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hyundae">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".reminder.ArrivalReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="길안내 중 목적지 도착과 주차(P단)를 감지해 실었던 짐을 챙기도록 알림" />
        </service>
        <!-- FCM 수신 -->
        <service
            android:name=".push.ChagokMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 앱이 백그라운드일 때 시스템이 띄우는 notification 메시지의 기본 채널·아이콘 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="push_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />
    </application>

</manifest>